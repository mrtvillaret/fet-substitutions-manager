# NOMÉS PER A DESENVOLUPAMENT LOCAL (copia a .env i edita les rutes).
# NO facis servir aquests valors en un servidor: la clau i les contrasenyes
# d'aquí són públiques. Per a producció, parteix del .env.example de l'arrel.
#
# L'aplicació ho fa complir: amb qualsevol ENVIRONMENT que no sigui
# "development", es nega a arrencar si hi troba aquests valors de mostra.

SECRET_KEY=dev-secret-key-change-in-production
ENVIRONMENT=development
COOKIE_SECURE=false

# Rutes locals — ajusta al teu sistema
DATA_DIR=/ruta/al/projecte/data
AUTH_DB_PATH=/ruta/al/projecte/data/auth.db
APP_INSTITUCIO=exemple

# Usuaris creats automàticament si no existeixen
ADMIN_USERNAME=super_admin
ADMIN_PASSWORD=admin123
ADMIN_INSTITUCIO=exemple

# Usuaris addicionals d'exemple (opcionals)
ADMIN_CENTRE1_USERNAME=admin_centre1
ADMIN_CENTRE1_PASSWORD=admin123
ADMIN_CENTRE1_INSTITUCIO=exemple

USER_CENTRE1_USERNAME=user_centre1
USER_CENTRE1_PASSWORD=user123
USER_CENTRE1_INSTITUCIO=exemple
