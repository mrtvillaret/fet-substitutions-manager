#: gui/configuracio_dialog.py:637
#, python-brace-format
msgid ""
"<b>Sistema de Gestió de Substitucions</b><br>Versió {version}"
"<br><br>Aplicació modular per gestionar substitucions<br>de professors i "
"vigilàncies d'exàmens en centres<br>educatius amb assignació automàtica per "
"categories<br>de prioritat i generació de PDFs.<br><br><b>Característiques:</"
"b><br>• Assignació automàtica per prioritats<br>• Gestió de vigilàncies "
"d'exàmens<br>• Generació de PDFs professionals<br>• Sincronització amb "
"Google Sheets<br>• Sistema de temes personalitzables<br>• Estadístiques "
"detallades de substitucions<br><br><b>Arquitectura modular:</b><br>Cada "
"fitxer manté menys de 50 línies per<br>màxima modularitat i facilitat de "
"manteniment."
msgstr ""
"categorías<b>Sistema de Gestión de Sustituciones</b><br>Versión {version}"
"<br><br>Aplicación modular para gestionar sustituciones<br>de profesores y "
"vigilancias de exámenes en centros<br>educativos, con asignación automática "
"por categorías<br>de prioridad y generación de PDFs."
"<br><br><b>Características:</b><br>• Asignación automática por "
"prioridades<br>• Gestión de vigilancias de exámenes<br>• Generación de PDFs "
"profesionales<br>• Sincronización con Google Sheets<br>• Sistema de temas "
"personalizables<br>• Estadísticas detalladas de "
"sustituciones<br><br><b>Arquitectura modular:</b><br>Cada archivo mantiene "
"menos de 50 líneas para<br>máxima modularidad y facilidad de mantenimiento."

