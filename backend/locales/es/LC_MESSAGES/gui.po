msgid "ℹ️ Com funcionen les baixes"
msgstr "ℹ️ Cómo funcionan las bajas"

#: gui/configuracio_dialog.py:560
msgid ""
"<b>Efectes de marcar un professor de baixa:</b><br><br>• <b>No substitueix:</"
"b> El professor de baixa no apareixerà a les llistes de substituts "
"disponibles<br>• <b>No és substituït:</b> Les seves classes no generaran "
"necessitat de substitució<br>• <b>Visualització:</b> Apareixerà amb color "
"especial a les llistes si es mostra<br>• <b>Període:</b> Les baixes només "
"s'apliquen entre les dates especificades<br><br><b>Nota:</b> Recordeu desar "
"els canvis després d'afegir, editar o eliminar baixes."
msgstr ""
"<b>Efectos de marcar un profesor de baja:</b><br><br>• <b>No sustituye:</b> "
"El profesor de baja no aparecerá en las listas de sustitutos "
"disponibles<br>• <b>No es sustituido:</b> Sus clases no generarán necesidad "
"de sustitución<br>• <b>Visualización:</b> Aparecerá con color especial en "
"las listas si se muestra<br>• <b>Período:</b> Las bajas solo se aplican "
"entre las fechas especificadas<br><br><b>Nota:</b> Recuerde guardar los "
"cambios después de añadir, editar o eliminar bajas."

