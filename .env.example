# Configuració Docker (copia a .env i edita)

# Clau secreta que signa les sessions. OBLIGATÒRIA: sense ella l'aplicació no
# arrenca. Genera-la amb:  openssl rand -hex 32
# Qui la conegui pot entrar com a qualsevol usuari, així que no la comparteixis
# ni reutilitzis la d'un altre desplegament.
SECRET_KEY=

# Institució per defecte carregada en arrencar.
# "exemple" usa les dades demo incloses al repo.
# Pots gestionar institucions des de l'app (super_admin > Configuració > Institucions).
APP_INSTITUCIO=exemple

# Rutes de dades (dins del contenidor, no canviar)
DATA_DIR=/app/data
AUTH_DB_PATH=/app/data/auth.db

# Usuari administrador que es crea al primer arrencada. La contrasenya és
# OBLIGATÒRIA mentre aquest usuari no existeixi: no hi ha cap valor per
# defecte, precisament perquè una instal·lació no quedi oberta amb una
# contrasenya que consta al codi públic. Canvia-la des de l'aplicació quan
# hi hagis entrat.
ADMIN_USERNAME=super_admin
ADMIN_PASSWORD=
ADMIN_INSTITUCIO=exemple

# Entorn. Qualsevol valor que no sigui "development" desactiva /docs, /redoc i
# /openapi.json, i fa que l'aplicació no arrenqui amb els valors de mostra del
# backend/.env.example.
ENVIRONMENT=production

# Cookies segures (true en producció amb HTTPS, false en local)
COOKIE_SECURE=true
